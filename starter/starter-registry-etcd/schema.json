{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.registry.etcd",
  "type": "object",
  "properties": {
    "endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "username": {
      "type": "string",
      "default": ""
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "dial-timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "5s"
    },
    "ttl": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "15s"
    },
    "key-prefix": {
      "type": "string",
      "default": "/services/"
    },
    "tls": {
      "type": "object"
    },
    "spring.registry.service-name": {
      "type": "string",
      "description": "Logical service name to advertise",
      "default": ""
    },
    "spring.registry.addr": {
      "type": "string",
      "description": "Advertised host:port of this instance",
      "default": ""
    },
    "spring.registry.id": {
      "type": "string",
      "description": "Instance id override; empty derives from service-name+addr",
      "default": ""
    },
    "spring.registry.weight": {
      "type": "integer",
      "default": 0
    },
    "spring.registry.metadata": {
      "type": "object",
      "description": "Arbitrary key/value attributes stored with the instance",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "spring.registry.service-name",
    "spring.registry.addr"
  ]
}
