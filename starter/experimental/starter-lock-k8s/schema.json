{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.lock",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "default": "default"
    },
    "kubeconfig": {
      "type": "string",
      "default": ""
    },
    "key-prefix": {
      "type": "string",
      "default": ""
    },
    "observe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Wrap the Locker with the observe-lock adapter; false = bare locker"
        }
      }
    },
    "observability": {
      "type": "object",
      "description": "Access log config (off/brief/detailed), see observe.ObserveConfig"
    }
  }
}