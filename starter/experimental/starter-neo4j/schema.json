{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.neo4j",
  "type": "object",
  "description": "Two buckets: spring.neo4j.default holds family-wide values (each overridable per instance), spring.neo4j.instances.<name> holds one entry per named instance. No other key belongs directly under spring.neo4j.instances.",
  "properties": {
    "default": {
      "type": "object",
      "description": "Family-wide values, each overridable by an instance.",
      "properties": {
        "driver": {
          "type": "string",
          "default": "",
          "description": "Names the Driver bean that assembles every instance's transport unless an instance names its own. Empty injects the single Driver bean by type; naming a missing bean fails startup."
        }
      }
    },
    "instances": {
      "type": "object",
      "description": "One entry per instance; the key is the bean name, and any name is legal.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "default": ""
          },
          "password": {
            "type": "string",
            "default": ""
          },
          "realm": {
            "type": "string",
            "default": ""
          },
          "max-connection-pool-size": {
            "type": "integer",
            "default": 100
          },
          "max-connection-lifetime": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "1h"
          },
          "connection-acquisition-timeout": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "1m"
          },
          "socket-connect-timeout": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "5s"
          },
          "max-transaction-retry-time": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "30s"
          },
          "tls": {
            "type": "object"
          },
          "service-name": {
            "type": "string",
            "default": ""
          },
          "scheme": {
            "type": "string",
            "default": "",
            "description": "Narrows discovery to endpoints of one transport scheme (e.g. tls, https). Empty returns every scheme. Only used with service-name."
          },
          "discovery": {
            "type": "string",
            "default": ""
          },
          "resilience": {
            "type": "object",
            "default": ""
          }
        }
      }
    }
  }
}
