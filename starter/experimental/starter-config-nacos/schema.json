{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.config.import (nacos://...)",
  "description": "Nacos remote configuration provider. Configured via spring.config.import URL.",
  "type": "object",
  "properties": {
    "nacos-url": {
      "type": "string",
      "description": "URL format: nacos://host:port/data-id?group=xxx&namespace=xxx"
    },
    "govern.source.nacos": {
      "type": "object",
      "description": "Governance rules source bound at govern.source.nacos.*",
      "properties": {
        "server": {
          "type": "string",
          "description": "Nacos server address, required"
        },
        "data-id": {
          "type": "string",
          "description": "Governance rules dataId, required"
        },
        "group": {
          "type": "string",
          "default": "DEFAULT_GROUP"
        },
        "namespace": {
          "type": "string",
          "default": ""
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        },
        "format": {
          "type": "string",
          "description": "Override document format; inferred from dataId extension by default",
          "default": ""
        }
      },
      "required": [
        "server",
        "data-id"
      ]
    }
  }
}
