{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.goframe.ws.server",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "goframe"
    },
    "address": {
      "type": "string"
    },
    "registry": {
      "type": "object",
      "properties": {
        "etcd": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
