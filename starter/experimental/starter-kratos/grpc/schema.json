{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.kratos.grpc.server",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "kratos-grpc"
    },
    "network": {
      "type": "string",
      "default": ""
    },
    "addr": {
      "type": "string",
      "default": ""
    },
    "timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "1s"
    },
    "etcd": {
      "type": "object",
      "properties": {
        "addr": {
          "type": "string",
          "default": ""
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
