{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.kafka",
  "type": "object",
  "description": "Two buckets: spring.kafka.default holds family-wide values (each overridable per instance), spring.kafka.instances.<name> holds one entry per named instance. No other key belongs directly under spring.kafka.",
  "properties": {
    "default": {
      "type": "object",
      "description": "Family-wide values, each overridable by an instance.",
      "properties": {
        "driver": {
          "type": "string",
          "default": "",
          "description": "Names the Driver bean that assembles every instance's transport unless an instance names its own. Empty injects the single Driver bean by type; naming a missing bean fails startup."
        }
      }
    },
    "instances": {
      "type": "object",
      "description": "One entry per instance; the key is the bean name, and any name is legal.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "brokers": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "default": ""
          },
          "group": {
            "type": "string",
            "default": ""
          },
          "sasl": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "mechanism": {
                "type": "string",
                "default": "plain"
              },
              "username": {
                "type": "string",
                "default": ""
              },
              "password": {
                "type": "string",
                "default": ""
              }
            }
          },
          "tls": {
            "type": "object"
          },
          "producer": {
            "type": "object",
            "properties": {
              "compression": {
                "type": "string",
                "default": ""
              },
              "required-acks": {
                "type": "string",
                "default": "all"
              },
              "max-batch-bytes": {
                "type": "integer",
                "default": 0
              },
              "linger": {
                "type": "string",
                "description": "Duration string, e.g. '5s', '1m', '1h'",
                "default": "0s"
              }
            }
          }
        }
      }
    }
  }
}
