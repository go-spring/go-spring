{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.memcached",
  "type": "object",
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ""
    },
    "service-name": {
      "type": "string",
      "default": ""
    },
    "scheme": {
      "type": "string",
      "default": "",
      "description": "Narrows discovery to endpoints of one transport scheme (e.g. tls, https). Empty returns every scheme. Only used with service-name."
    },
    "discovery": {
      "type": "string",
      "default": "default"
    },
    "timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "0"
    },
    "max-idle-conns": {
      "type": "integer",
      "default": 0
    },
    "driver": {
      "type": "string",
      "default": "DefaultDriver"
    }
  }
}