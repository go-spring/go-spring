{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.kitex.server",
  "type": "object",
  "properties": {
    "addr": {
      "type": "string"
    },
    "service.name": {
      "type": "string",
      "default": "kitex"
    },
    "registry.etcd": {
      "type": "string",
      "default": ""
    },
    "compatible-unary-middleware": {
      "type": "boolean",
      "default": false
    },
    "tracing": {
      "type": "object",
      "description": "Global-first: with starter-otel's global pipeline present the suite attaches to it and endpoint/insecure are ignored; without it the starter builds its own OTLP/gRPC provider.",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true
        },
        "endpoint": {
          "type": "string",
          "default": "127.0.0.1:4317"
        },
        "insecure": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "A dedicated prometheus scrape server starts only when port is explicitly configured; otherwise kitex metrics ride the global pipeline (tracing suite histogram) or stay dormant without one.",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "default": 0
        },
        "path": {
          "type": "string",
          "default": "/metrics"
        }
      }
    }
  }
}