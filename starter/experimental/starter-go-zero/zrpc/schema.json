{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.go-zero.zrpc.server",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "go-zero"
    },
    "listen-on": {
      "type": "string"
    },
    "etcd": {
      "type": "object",
      "properties": {
        "addr": {
          "type": "string",
          "default": ""
        },
        "key": {
          "type": "string",
          "default": ""
        }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean",
          "default": true
        },
        "endpoint": {
          "type": "string",
          "default": ""
        },
        "sampler": {
          "type": "number",
          "default": 1.0
        },
        "batcher": {
          "type": "string",
          "default": "otlpgrpc"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "default": 6060
        },
        "path": {
          "type": "string",
          "default": "/metrics"
        }
      }
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "default": "info"
        }
      }
    }
  }
}
