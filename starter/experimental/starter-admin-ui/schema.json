{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.admin-ui",
  "type": "object",
  "properties": {
    "addr": {
      "type": "string",
      "description": "Listen address; setting this key activates the starter (no default)."
    },
    "token": {
      "type": "string",
      "description": "Optional bearer token guarding the dashboard",
      "default": ""
    },
    "username": {
      "type": "string",
      "description": "Optional HTTP Basic username (with password)",
      "default": ""
    },
    "password": {
      "type": "string",
      "description": "Optional HTTP Basic password (with username)",
      "default": ""
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ""
    },
    "interval": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "10s"
    },
    "timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "3s"
    },
    "title": {
      "type": "string",
      "default": "Go-Spring Admin"
    }
  }
}