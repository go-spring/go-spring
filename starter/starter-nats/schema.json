{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.nats",
  "type": "object",
  "description": "Two buckets: spring.nats.default holds family-wide values (each overridable per instance), spring.nats.instances.<name> holds one entry per named instance. No other key belongs directly under spring.nats.",
  "properties": {
    "default": {
      "type": "object",
      "description": "Family-wide values, each overridable by an instance.",
      "properties": {
        "driver": {
          "type": "string",
          "default": "",
          "description": "Names the Driver bean that assembles every instance's transport unless an instance names its own. Empty injects the single Driver bean by type; naming a missing bean fails startup."
        }
      }
    },
    "instances": {
      "type": "object",
      "description": "One entry per instance; the key is the bean name, and any name is legal.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "username": {
            "type": "string",
            "default": ""
          },
          "password": {
            "type": "string",
            "default": ""
          },
          "token": {
            "type": "string",
            "default": ""
          },
          "creds-file": {
            "type": "string",
            "default": ""
          },
          "nkey-file": {
            "type": "string",
            "default": ""
          },
          "tls": {
            "type": "object"
          },
          "max-reconnects": {
            "type": "integer",
            "default": 60
          },
          "reconnect-wait": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "2s"
          },
          "connect-timeout": {
            "type": "string",
            "description": "Duration string, e.g. '5s', '1m', '1h'",
            "default": "5s"
          },
          "jetstream": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
