{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.kafka-sarama",
  "type": "object",
  "properties": {
    "brokers": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": ""
    },
    "sasl": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mechanism": {
          "type": "string",
          "default": "plain"
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        }
      }
    },
    "tls": {
      "type": "object"
    },
    "producer": {
      "type": "object",
      "properties": {
        "compression": {
          "type": "string",
          "default": ""
        },
        "required-acks": {
          "type": "string",
          "default": "all"
        }
      }
    }
  }
}