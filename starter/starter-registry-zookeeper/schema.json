{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.registry.zookeeper",
  "type": "object",
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "session-timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "10s"
    },
    "base-path": {
      "type": "string",
      "default": "/services"
    },
    "username": {
      "type": "string",
      "default": ""
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "discovery-name": {
      "type": "string",
      "description": "Label for the discovery backend bean derived from this same ensemble; empty disables it",
      "default": "zookeeper"
    },
    "spring.registry.service-name": {
      "type": "string",
      "description": "Logical service name to advertise",
      "default": ""
    },
    "spring.registry.addr": {
      "type": "string",
      "description": "Advertised host:port of this instance",
      "default": ""
    },
    "spring.registry.id": {
      "type": "string",
      "description": "Instance id override; empty derives from service-name+addr",
      "default": ""
    },
    "spring.registry.weight": {
      "type": "integer",
      "default": 0
    },
    "spring.registry.metadata": {
      "type": "object",
      "description": "Arbitrary key/value attributes stored with the instance",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "spring.registry.service-name",
    "spring.registry.addr"
  ]
}
