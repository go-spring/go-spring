{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.registry.zookeeper",
  "type": "object",
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "session-timeout": {
      "type": "string",
      "description": "Duration string, e.g. '5s', '1m', '1h'",
      "default": "10s"
    },
    "base-path": {
      "type": "string",
      "default": "/services"
    },
    "username": {
      "type": "string",
      "default": ""
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": "default"
    }
  }
}