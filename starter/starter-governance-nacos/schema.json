{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.governance.source.nacos",
  "description": "Nacos-backed governance rule source. The bean is registered only when spring.governance.source.nacos is present.",
  "type": "object",
  "properties": {
    "spring.governance.source.nacos": {
      "type": "object",
      "description": "Governance rules source bound at spring.governance.source.nacos.*",
      "properties": {
        "server": {
          "type": "string",
          "description": "Nacos server address, required"
        },
        "data-id": {
          "type": "string",
          "description": "Governance rules dataId, required"
        },
        "group": {
          "type": "string",
          "default": "DEFAULT_GROUP"
        },
        "namespace": {
          "type": "string",
          "default": ""
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        },
        "format": {
          "type": "string",
          "description": "Override document format; inferred from dataId extension by default",
          "default": ""
        }
      },
      "required": [
        "server",
        "data-id"
      ]
    }
  }
}
