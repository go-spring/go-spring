{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spring.registry.nacos",
  "type": "object",
  "properties": {
    "server": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "default": ""
    },
    "group": {
      "type": "string",
      "default": "DEFAULT_GROUP"
    },
    "cluster": {
      "type": "string",
      "default": "DEFAULT"
    },
    "username": {
      "type": "string",
      "default": ""
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "timeout-ms": {
      "type": "integer",
      "default": 5000
    },
    "spring.registry.service-name": {
      "type": "string",
      "description": "Logical service name to advertise",
      "default": ""
    },
    "spring.registry.addr": {
      "type": "string",
      "description": "Advertised host:port of this instance",
      "default": ""
    },
    "spring.registry.weight": {
      "type": "integer",
      "default": 0
    },
    "spring.registry.metadata": {
      "type": "object",
      "description": "Arbitrary key/value attributes stored with the instance",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "spring.registry.service-name",
    "spring.registry.addr"
  ]
}
